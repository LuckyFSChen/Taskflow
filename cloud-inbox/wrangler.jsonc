{
  // 這是設定範本，不含任何真實帳號、資料庫 ID 或密鑰。
  // 部署前請替換 "name"、"database_name"、"database_id" 為你自己 Cloudflare 帳號下的資源。
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "taskflow-cloud-inbox",
  "account_id": "4e77c57cb08e0e8c90c9d889ae035a80",
  "workers_dev": true,
  "main": "worker.js",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": [],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "taskflow-inbox",
      "database_id": "73ba82ce-6f8c-4a0e-8876-60616c2e4fe3"
    }
  ],

  // 非機密設定可放這裡；機密一律用 `wrangler secret put` 個別設定，
  // 不要寫進本檔案或版本庫：
  //   LINE_CHANNEL_SECRET       LINE Developers channel secret
  //   LINE_CHANNEL_ACCESS_TOKEN LINE Messaging API channel access token
  //   INBOX_TOKEN               本機 runner 與此 Worker 之間的共用 bearer token
  "vars": {}
}
