PORT=4310
HOST=127.0.0.1
PUBLIC_ORIGIN=http://127.0.0.1:4310
# Set true only behind your HTTPS tunnel.
COOKIE_SECURE=false
# Optional absolute paths if executables are not on PATH.
CODEX_BIN=codex
CLAUDE_BIN=claude
# Cloud inbox Worker URL and its shared runner secret.
INBOX_URL=
INBOX_TOKEN=
# Direct LINE push notification token (optional if cloud inbox is configured).
LINE_CHANNEL_ACCESS_TOKEN=

# LINE general conversation uses a signed-in local CLI (no separate API key).
# Optional Chat defaults. Admin UI settings (平台設定 → AI 模型) override these values.
# Chat settings are independent from the Task Runner engine configuration.
CHAT_PROVIDER=codex
CHAT_MODEL_CODEX=
CHAT_MODEL_CLAUDE=

# Legacy fallback for Codex Chat: still honoured, but only when neither the admin UI
# nor CHAT_MODEL_CODEX sets a model. Kept for compatibility; migrate when convenient.
LINE_GPT_MODEL=gpt-6-astra
